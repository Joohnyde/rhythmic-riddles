{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-protocolVersion": "implicit-v1",
  "$id": "https://cestereg.local/websocket-contracts/v1/schema/welcome.schema.json",
  "title": "WebSocket welcome/context snapshot frame",
  "description": "Initial/recovery context snapshot. Covers current integration recovery shape plus documented lobby/albums/songs/winner snapshots.",
  "x-recipients": ["admin", "tv"],
  "x-replaySafe": true,
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "stage", "teams"],
      "properties": {
        "type": {
          "const": "welcome"
        },
        "stage": {
          "const": "lobby"
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/team"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "stage"],
      "properties": {
        "type": {
          "const": "welcome"
        },
        "stage": {
          "const": "albums"
        },
        "albums": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "team": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "type",
        "stage",
        "songId",
        "question",
        "answer",
        "scheduleId",
        "answerDuration",
        "scores"
      ],
      "properties": {
        "type": {
          "const": "welcome"
        },
        "stage": {
          "const": "songs"
        },
        "songId": {
          "$ref": "#/$defs/uuid"
        },
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "scheduleId": {
          "$ref": "#/$defs/uuid"
        },
        "answerDuration": {
          "type": "number",
          "minimum": 0
        },
        "scores": {
          "$ref": "#/$defs/teamScores"
        },
        "revealed": {
          "type": "boolean"
        },
        "bravo": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "const": "null"
            },
            {
              "type": "null"
            }
          ]
        },
        "seek": {
          "type": "number",
          "minimum": 0
        },
        "remaining": {
          "type": "number",
          "minimum": 0
        },
        "answeringTeam": {
          "$ref": "#/$defs/team"
        },
        "interruptId": {
          "$ref": "#/$defs/uuid"
        },
        "error": {
          "type": "boolean"
        }
      },
      "dependentRequired": {
        "answeringTeam": ["interruptId"],
        "interruptId": ["answeringTeam"]
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "stage", "scores"],
      "properties": {
        "type": {
          "const": "welcome"
        },
        "stage": {
          "const": "winner"
        },
        "scores": {
          "$ref": "#/$defs/teamScores"
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "team": {
      "type": "object",
      "required": ["id", "name", "image"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "teamScore": {
      "type": "object",
      "required": ["teamId", "image", "name", "score", "scheduleId"],
      "properties": {
        "teamId": {
          "$ref": "#/$defs/uuid"
        },
        "image": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "scheduleId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "teamScores": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/teamScore"
      }
    }
  }
}
