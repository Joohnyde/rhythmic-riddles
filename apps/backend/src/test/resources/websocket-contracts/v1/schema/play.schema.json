{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-protocolVersion": "implicit-v1",
  "$id": "https://cestereg.local/websocket-contracts/v1/schema/play.schema.json",
  "title": "WebSocket play frame",
  "description": "The TV audio element began playback.",
  "x-recipients": [
    "admin"
  ],
  "x-replaySafe": false,
  "type": "object",
  "required": [
    "type",
    "scheduleId"
  ],
  "properties": {
    "type": {
      "const": "play"
    },
    "scheduleId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "additionalProperties": false
}
