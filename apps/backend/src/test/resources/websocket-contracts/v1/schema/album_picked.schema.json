{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-protocolVersion": "implicit-v1",
  "$id": "https://cestereg.local/websocket-contracts/v1/schema/album_picked.schema.json",
  "title": "WebSocket album_picked frame",
  "description": "Album/category picked. selected is LastCategory payload.",
  "x-recipients": ["tv"],
  "x-replaySafe": false,
  "type": "object",
  "required": ["type", "selected"],
  "properties": {
    "type": {
      "const": "album_picked"
    },
    "selected": {
      "type": "object",
      "required": [
        "categoryId",
        "chosenCategoryPreview",
        "pickedByTeam",
        "started",
        "ordinalNumber"
      ],
      "properties": {
        "categoryId": {
          "$ref": "#/$defs/uuid"
        },
        "chosenCategoryPreview": {
          "type": "object",
          "required": ["title", "image"],
          "properties": {
            "title": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/uuid"
            }
          },
          "additionalProperties": false
        },
        "pickedByTeam": {
          "oneOf": [
            {
              "$ref": "#/$defs/team"
            },
            {
              "type": "null"
            }
          ]
        },
        "started": {
          "type": "boolean"
        },
        "ordinalNumber": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "team": {
      "type": "object",
      "required": ["id", "name", "image"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  }
}
