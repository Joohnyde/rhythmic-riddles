{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-protocolVersion": "implicit-v1",
  "$id": "https://cestereg.local/websocket-contracts/v1/schema/new_team.schema.json",
  "title": "WebSocket new_team frame",
  "description": "Team created, TV should update team list.",
  "x-recipients": [
    "tv"
  ],
  "x-replaySafe": false,
  "type": "object",
  "required": [
    "type",
    "team"
  ],
  "properties": {
    "type": {
      "const": "new_team"
    },
    "team": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
